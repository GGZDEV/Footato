node_modules/
dist/
.DS_Store
*.local

# Raw Transfermarkt CSV exports — ~20 Mo, re-downloadable with `npm run data:fetch`.
# The contents are excluded rather than the directory itself, because git cannot
# re-include a path inside an excluded directory.
data/raw/*

# ...except the first-party collection. It is small (<1 Mo) and, unlike the
# imports, it cannot be downloaded again: it is a reading of pages that change
# every day. Versioning it keeps the last good mercato available when a CI
# runner is blocked, and leaves an auditable trail of what the window looked
# like on each build.
!data/raw/collected/
data/raw/collected/*.part

# TypeScript incremental build info
tsconfig.tsbuildinfo

# Jetons de l'instance auto-hébergée. Jamais versionnés.
.env

# Historique des exécutions du service auto-hébergé, propre à chaque instance.
data/state/

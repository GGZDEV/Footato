# Copiez ce fichier en .env avant `docker compose up -d`.
# .env est ignoré par git : ne versionnez jamais vos jetons.

# Jeton du bouton « Collecter » et de l'endpoint /api/refresh.
# Sans lui, la collecte automatique tourne quand même, mais le déclenchement
# manuel est refusé (503). Générez-en un avec :
#   openssl rand -hex 24
FOOTATO_ADMIN_TOKEN=

# Intervalle entre deux collectes automatiques, en heures. 0 désactive.
REFRESH_INTERVAL_HOURS=6

# Une passe sur N retélécharge les instantanés tiers (20 Mo). Les autres se
# contentent de relire Transfermarkt, ce qui coûte 30 requêtes.
REFRESH_FULL_EVERY=4

# Facultatif : contrôle d'effectifs football-data.org (clé gratuite).
FOOTBALL_DATA_TOKEN=

# Facultatif et inutile en auto-hébergement : ne sert qu'à débloquer une
# collecte lancée depuis un centre de données.
BRIGHTDATA_API_KEY=

# Interpréteur Python utilisé pour extraire les tableaux DNCG. Le conteneur le
# configure déjà ; ailleurs, indiquez un Python avec `requirements-finance.txt`.
FINANCE_PYTHON=

TZ=Europe/Paris
